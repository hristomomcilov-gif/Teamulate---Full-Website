# Public marketing site. Do not password this folder.
# Full-page /login goes to the field form. Do not send it to /app/.
RewriteEngine On
RewriteRule ^login/?$ /client-login.html [R=302,L]
# Sitemap: PHP generator so `<?xml` is never parsed as a short PHP tag (HTTP 500).
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
